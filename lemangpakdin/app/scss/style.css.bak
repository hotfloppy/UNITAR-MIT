html {
  -webkit-box-sizing: border-box;
          box-sizing: border-box;
  font-size: 100%;
}

body {
  margin: 0;
  padding: 5px;
  line-height: 1.2;
  font-family: "Comfortaa", cursive;
  /* Permalink - use to edit and share this gradient: https://colorzilla.com/gradient-editor/#398235+0,8ab66b+56,c9de96+100 */
  background: #398235;
  /* Old browsers */
  /* FF3.6-15 */
  /* Chrome10-25,Safari5.1-6 */
  background: linear-gradient(45deg, #398235 0%, #8ab66b 56%, #c9de96 100%);
  /* W3C, IE10+, FF16+, Chrome26+, Opera12+, Safari7+ */
  filter: progid:DXImageTransform.Microsoft.gradient(startColorstr='#398235', endColorstr='#c9de96', GradientType=1);
  /* IE6-9 fallback on horizontal gradient */
}

body h1 {
  font-family: "Comfortaa", cursive;
  font-size: 2.1rem;
  font-weight: 700;
  -webkit-transition: all 300ms ease;
  transition: all 300ms ease;
}

body .customer {
  font-family: "Comfortaa", cursive;
}
